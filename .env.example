# Servidor local
PORT=3002

# Opcional: caminho explícito do Python usado pelo MotionCore
# Windows: C:\Path\to\python.exe
# macOS: /opt/homebrew/bin/python3
PYTHON_EXE=

# Opcional: senha inicial do administrador local
KLIPE_ADMIN_PASSWORD=

# Integrações opcionais. Nunca grave chaves reais neste arquivo.
GEMINI_API_KEY=
PEXELS_API_KEY=

# Opcional: pasta de ativos externos para o módulo CBV
KLIPE_CBV_ASSETS=
